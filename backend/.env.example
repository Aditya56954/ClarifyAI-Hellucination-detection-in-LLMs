# ==========================================
# ClarifyAI Environment Configuration
# ==========================================

# ------------------------------------------
# Database
# ------------------------------------------
# PostgreSQL connection string used by SQLAlchemy.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME


# ------------------------------------------
# Authentication / JWT
# ------------------------------------------
# Secret used to sign JWT access tokens.
# Use a long, random secret in the real .env file.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# JWT signing algorithm.
JWT_ALGORITHM=HS256

# Access-token lifetime in minutes.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30


# ------------------------------------------
# Retrieval
# ------------------------------------------
# API key for the configured web retrieval provider.
TAVILY_API_KEY=


# ------------------------------------------
# Gemini / Answer Generation
# ------------------------------------------
# API key used for Gemini answer generation.
GEMINI_API_KEY=

# Gemini model used by ClarifyAI.
GEMINI_MODEL = gemini-3.6-flash